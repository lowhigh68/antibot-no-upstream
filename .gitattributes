# Shell script + config deploy lên Linux: BẮT BUỘC LF.
# Repo từng commit CRLF (edit trên Windows, không có .gitattributes) → server
# `git pull` nhận file có \r → bash vỡ ngay: syntax error near unexpected
# token `$'in\r'`. `eol=lf` đảm bảo checkout ra LF trên MỌI nền tảng.
*.sh        text eol=lf
*.lua       text eol=lf
*.conf      text eol=lf
*.json      text eol=lf
*.md        text eol=lf
# Khong co duoi file nen khong roi vao mau nao o tren; logrotate doc CRLF ra loi
# "unexpected text" rat kho lan. Cung ly do da ghi o dau file.
nginx/logrotate/*   text eol=lf
