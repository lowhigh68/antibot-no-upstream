# Xoay vong log antibot. Cai vao /etc/logrotate.d/antibot bang deploy.sh.
#
# Vi sao file nay nam trong repo: truoc day rotation cau hinh bang tay tren tung
# may va da troi — cloud183-139 co antibot.log KHONG xoay suot 28 ngay, khien
# mot phep do bi lech 46 lan vi cua so thoi gian khong nhu tuong. Cau hinh nam
# canh code thi `git pull` la dong bo.
#
# `create` chu KHONG `copytruncate`:
#   `async/logger.lua` va `async/waf_logger.lua` deu `io.open(path,"a")` roi
#   `close()` cho TUNG request — khong giu file handle qua request. Nen doi ten
#   file cu roi tao file moi la an toan tuyet doi: request ke tiep mo dung file
#   moi, khong can bao hieu gi cho nginx. `copytruncate` nguoc lai co khe cua so
#   giua luc copy va luc truncate, mat dong ghi vao do — khong co ly do nao de
#   chap nhan rui ro do o day.
#
# Chu so huu phai la `nginx`: worker chay duoi user do (nginx.conf:19 `user nginx;`).
# Tao file 0640 root:root la worker khong ghi duoc, va trieu chung se la mot
# dong `cannot open log file` trong error log roi im lang mat log.

/var/log/antibot/antibot.log {
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    create 0640 nginx nginx
}

# waf.log tach rieng vi soi thu cong nhieu hon han. Giu lau hon antibot.log:
# no nho hon nhieu lan (chi ghi khi co luat ban, khong ghi moi request) va khi
# dieu tra mot vu thi thuong phai nhin nguoc lai xa hon.
/var/log/antibot/waf.log {
    daily
    rotate 30
    missingok
    notifempty
    compress
    delaycompress
    create 0640 nginx nginx
}

# FIM ghi bang `tee -a` mot lan moi lan chay (cron hang ngay), khong giu handle
# — nen `create` an toan giong hai khoi tren. Chu so huu root vi cron chay duoi
# root, khac antibot.log do worker nginx ghi.
/var/log/antibot/fim.log {
    weekly
    rotate 12
    missingok
    notifempty
    compress
    delaycompress
    create 0640 root root
}

# ── Log cua CHINH nginx ───────────────────────────────────────────────
# Nam trong file ten `antibot` vi deploy.sh buoc [4b] cai dung MOT file nay.
# Tach ra file thu hai la them mot duong cai dat nua cho cung mot loai cau hinh.
#
# Do 2026-09-02: ba file nay CHUA TUNG xoay ke tu 22/7 — access.log 433 MB,
# error.log 22 MB, hostname.log 19 MB. Hau qua khong phai het dia (con day cho)
# ma la MU CHAN DOAN: error.log con om nguyen su co 5.858 dong tu 21-22/7 (reboot
# chua bat Redis), va dong do lam nhieu moi phep do, ton han mot luot dieu tra
# moi xac dinh duoc ma moi co nem loi hay khong.
#
# `kill -USR1` la BAT BUOC o day, va day la cho khac han khoi antibot.log phia
# tren. nginx GIU file handle cua access/error log suot doi worker, khong mo-ghi-
# dong tung request nhu logger.lua. Doi ten ma khong bao hieu thi worker tiep tuc
# ghi vao inode cu, file moi dung yen 0 byte, va log bien mat LANG LE — dung kieu
# hong ma ca file nay sinh ra de tranh.
#
# `create 0644 root root` chu khong phai `nginx nginx`: master process (chay
# duoi root) moi la ben mo nhung file nay, khac voi antibot.log do worker mo.
# Dat sai chu so huu o day la nginx khong mo lai duoc sau khi xoay.
#
# `delaycompress` de nginx kip nha file .1 truoc khi no bi nen.
/usr/local/openresty/nginx/logs/*.log {
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    sharedscripts
    create 0644 root root
    postrotate
        [ -s /usr/local/openresty/nginx/logs/nginx.pid ] && \
            kill -USR1 "$(cat /usr/local/openresty/nginx/logs/nginx.pid)"
    endscript
}
